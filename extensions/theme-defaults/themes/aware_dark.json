		"commandCenter.activeBackground": "#2E2E31",
		"commandCenter.activeForeground": "#FFFFFF",
		"commandCenter.activeBorder": "#FFFFFF26",
		"commandCenter.inactiveBorder": "#FFFFFF0F",
		"commandCenter.inactiveForeground": "#98989D"
